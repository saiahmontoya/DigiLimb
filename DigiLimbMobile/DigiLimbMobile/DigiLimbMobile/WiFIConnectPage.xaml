<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigiLimbMobile.WiFiConnectPage"
             Title="WiFi Connect">
    <VerticalStackLayout Padding="20" Spacing="20">
        <Label Text="Enter Desktop IP Address:" FontSize="18" />
        <Entry x:Name="entryServerIP" Placeholder="192.168.x.x" />
        <Label Text="Port:" FontSize="18" />
        <!-- Fixed port 8080 -->
        <Entry x:Name="entryPort" Text="8080" IsReadOnly="True" />
        <Button Text="Connect" Clicked="OnConnectClicked" />
		<Button Text="Scan QR Code" Clicked="OnScanQRCodeClicked"/>
		<Label x:Name="lblStatus" Text="Status: Not connected" FontSize="16" TextColor="Gray" />
        <Label Text="Send a message:" FontSize="18" />
        <Entry x:Name="entrySendMessage" Placeholder="Enter message to send" />
        <Button Text="Send Message" Clicked="OnSendMessageClicked" />
        <Label x:Name="lblReceived" Text="Received:" FontSize="16" TextColor="Black" />
    </VerticalStackLayout>
</ContentPage>
