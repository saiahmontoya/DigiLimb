<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="DigiLimbMobile.MousePage"
             Title="Track Pad">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Calibrate" Clicked="OnSettingsClicked"/>
    </ContentPage.ToolbarItems>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height=".3*"/>
                <RowDefinition Height=".7*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <BoxView Grid.Row="0" Grid.ColumnSpan="3" BackgroundColor="#90D5FF" AbsoluteLayout.LayoutBounds="0.5,0.5,300,300" AbsoluteLayout.LayoutFlags="PositionProportional">
                <BoxView.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnPanUpdated"/>
            </BoxView.GestureRecognizers>
            </BoxView>

        <Rectangle Grid.Row="1" Grid.ColumnSpan="3" BackgroundColor="#90D5FF" HeightRequest="65" VerticalOptions="Start" Stroke="#90D5FF"/>

        <Button Grid.Row="1"
                Grid.Column="0"
                Margin="3,0,8,0"
                HeightRequest="60"
                BackgroundColor="#d9ecfa"
                VerticalOptions="Start"
                CornerRadius="0"
                Pressed="LeftPressed"
                Released="LeftReleased">
        </Button>

        <BoxView Grid.Column="1"
                 Grid.Row="1"
                 Margin="5,0,5,0"
                 HeightRequest="60"
                 WidthRequest="60"
                 VerticalOptions="Start"
                 CornerRadius="0"
                 BackgroundColor="#d9ecfa">
                <BoxView.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnScrollUpdated" />
                </BoxView.GestureRecognizers>
        </BoxView>
            
        <Button Grid.Row="1" 
                Grid.Column="2"
                Margin="8,0,3,0"
                HeightRequest="60"
                VerticalOptions="Start"
                BackgroundColor="#d9ecfa"
                CornerRadius="0"
                Pressed="RightPressed"
                Released="RightReleased">
        </Button> 
    
            
        <StackLayout x:Name="SettingsPanel"
                     Grid.ColumnSpan="3"
                     Grid.Row="2"
                     Padding="10"
                     VerticalOptions="Start"
                     IsVisible="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
           
                <Label Grid.Row="0" Grid.Column="0" Text="Mouse Sensitivity" FontSize="20" />
                <Entry x:Name="MouseSensitivityEntry"
                       Keyboard="Numeric"
                       Placeholder="2"
                       Grid.Column="0"
                       Grid.Row="1"/>

                <Button Grid.Column =" 1" Grid.Row="1" Text="Done" Margin="10,0,0,0" Clicked="OnMouseDoneClicked" />
                <Label Grid.Column="0" Grid.Row="2" Text="Scroll Sensitivity" Margin="0,20,0,0" FontSize="20" />
                    <Entry x:Name="ScrollSensitivityEntry"
                       Keyboard="Numeric"
                       Placeholder="30"
                       Grid.Column="0"
                       Grid.Row="3"/>

                    <Button Grid.Column =" 1" Grid.Row="3" Text="Done" Margin="10,0,0,0" Clicked="OnScrollDoneClicked" />
            </Grid>
            
        </StackLayout>
        <!-- A label to show feedback of touch movement -->
        <Label Grid.ColumnSpan="3" x:Name="MovementFeedbackLabel" 
              VerticalOptions="Center" HorizontalOptions="Center" IsVisible="false" />
        <Label Grid.Row="1" Grid.ColumnSpan="3" x:Name="ClickLabel" VerticalOptions="Center" HorizontalOptions="Center" TextColor="White" IsVisible="false" />
        <Label Grid.Row="1" Grid.ColumnSpan="3" x:Name="ScrollFeedbackLabel" VerticalOptions="Center" HorizontalOptions="Center" IsVisible="false" />
    </Grid>

</ContentPage>