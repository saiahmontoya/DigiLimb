<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigiLimbMobile.KeyboardPage"
             Title="Virtual Keyboard">

    <VerticalStackLayout>
        <Label 
            Text="DigiLimb Keyboard"
            FontSize="24"
            HorizontalOptions="Center"
            Padding="10"/>

        <!-- Keyboard Layout -->
        <Grid x:Name="KeyboardGrid"
              Padding="10"
              ColumnSpacing="5"
              RowSpacing="5">
        </Grid>

        <Button Text="Close Keyboard"
                Clicked="OnCloseKeyboard"
                BackgroundColor="Red"
                TextColor="White"
                HorizontalOptions="Center"
                Margin="10"/>
    </VerticalStackLayout>

</ContentPage>
