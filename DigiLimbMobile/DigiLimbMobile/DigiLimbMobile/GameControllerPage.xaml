<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigiLimbMobile.GameControllerPage"
             Title="Game Controller"
             BackgroundColor="Black">

    <Grid Padding="20"
          RowDefinitions="*,Auto,Auto,*,Auto,Auto,*,*,*"
          ColumnDefinitions="*,*,*,*">

        <!-- Directional Pad -->
        <Button Text="⬅" Grid.Row="1" Grid.Column="0" Clicked="OnButtonPress" WidthRequest="70" HeightRequest="70"/>
        <Button Text="⬆" Grid.Row="0" Grid.Column="1" Clicked="OnButtonPress" WidthRequest="70" HeightRequest="70"/>
        <Button Text="⬇" Grid.Row="2" Grid.Column="1" Clicked="OnButtonPress" WidthRequest="70" HeightRequest="70"/>
        <Button Text="➡" Grid.Row="1" Grid.Column="2" Clicked="OnButtonPress" WidthRequest="70" HeightRequest="70"/>

        <!-- Action Buttons -->
        <Button Text="X" Grid.Row="5" Grid.Column="1" Clicked="OnButtonPress" WidthRequest="70" HeightRequest="70"/>
        <Button Text="A" Grid.Row="6" Grid.Column="0" Clicked="OnButtonPress" WidthRequest="70" HeightRequest="70"/>
        <Button Text="Y" Grid.Row="6" Grid.Column="2" Clicked="OnButtonPress" WidthRequest="70" HeightRequest="70"/>
        <Button Text="B" Grid.Row="7" Grid.Column="1" Clicked="OnButtonPress" WidthRequest="70" HeightRequest="70"/>

        <!-- Joystick Title -->
        <Label Text="Joystick Controller"
               Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
               TextColor="White"
               FontSize="20"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               VerticalOptions="Center"/>

        <!-- Joystick Pad -->
        <Grid x:Name="JoystickPad"
              Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4"
              HeightRequest="180"
              WidthRequest="180"
              BackgroundColor="#333333"
              HorizontalOptions="Center"
              VerticalOptions="Center">
            <Label Text="Move"
                   TextColor="White"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </Grid>

    </Grid>

</ContentPage>
