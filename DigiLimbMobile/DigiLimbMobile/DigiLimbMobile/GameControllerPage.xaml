<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigiLimbMobile.GameControllerPage"
             BackgroundColor="Black">

    <Grid BackgroundColor="Black">
        <AbsoluteLayout>

            <!-- Left Joystick -->
            <AbsoluteLayout x:Name="LeftJoystickBase"
                        AbsoluteLayout.LayoutBounds="0.07,0.85,150,150"
                        AbsoluteLayout.LayoutFlags="PositionProportional">
                <Frame BackgroundColor="#444" CornerRadius="75" HeightRequest="150" WidthRequest="150" HasShadow="False"/>
                <BoxView x:Name="LeftThumb" BackgroundColor="White" CornerRadius="25"
                     HeightRequest="50" WidthRequest="50"
                     AbsoluteLayout.LayoutBounds="0.5,0.5,50,50"
                     AbsoluteLayout.LayoutFlags="PositionProportional"/>
            </AbsoluteLayout>

            <!-- Right Joystick -->
            <AbsoluteLayout x:Name="RightJoystickBase"
                        AbsoluteLayout.LayoutBounds="0.93,0.85,150,150"
                        AbsoluteLayout.LayoutFlags="PositionProportional">
                <Frame BackgroundColor="#444" CornerRadius="75" HeightRequest="150" WidthRequest="150" HasShadow="False"/>
                <BoxView x:Name="RightThumb" BackgroundColor="White" CornerRadius="25"
                     HeightRequest="50" WidthRequest="50"
                     AbsoluteLayout.LayoutBounds="0.5,0.5,50,50"
                     AbsoluteLayout.LayoutFlags="PositionProportional"/>
            </AbsoluteLayout>

            <!-- Triggers (Top Row - LT, LB, RB, RT) -->
            <StackLayout Orientation="Horizontal"
                     AbsoluteLayout.LayoutBounds="0.5,1,-1,-1"
                     AbsoluteLayout.LayoutFlags="PositionProportional"
                     Spacing="15">
                <Button Text="LT" WidthRequest="110" HeightRequest="40" Pressed="OnButtonDown" Released="OnButtonUp"/>
                <Button Text="LB" WidthRequest="110" HeightRequest="40" Pressed="OnButtonDown" Released="OnButtonUp"/>
                <Button Text="RB" WidthRequest="110" HeightRequest="40" Pressed="OnButtonDown" Released="OnButtonUp"/>
                <Button Text="RT" WidthRequest="110" HeightRequest="40" Pressed="OnButtonDown" Released="OnButtonUp"/>
            </StackLayout>

            <!-- Back & Start (Top Left Corner) -->
            <StackLayout AbsoluteLayout.LayoutBounds="0.05,0.05,-1,-1"
                     AbsoluteLayout.LayoutFlags="PositionProportional"
                     Spacing="5">
                <Button Text="Back" WidthRequest="60" HeightRequest="35" Pressed="OnButtonDown" Released="OnButtonUp"/>
                <Button Text="Start" WidthRequest="60" HeightRequest="35" Pressed="OnButtonDown" Released="OnButtonUp"/>
            </StackLayout>

            <!-- D-Pad (Left Center) -->
            <Grid AbsoluteLayout.LayoutBounds="0.30,0.17,-1,-1"
              AbsoluteLayout.LayoutFlags="PositionProportional"
              ColumnSpacing="-15" RowSpacing="-15"
              RowDefinitions="Auto,Auto,Auto"
              ColumnDefinitions="Auto,Auto,Auto"
              Margin="0,0,10,0">
                <Button Text="UP" WidthRequest="85" HeightRequest="85" Grid.Row="0" Grid.Column="1" 
                        CornerRadius ="42" Pressed="OnButtonDown" Released="OnButtonUp"/>
                <Button Text="LEFT" WidthRequest="85" HeightRequest="85" Grid.Row="1" Grid.Column="0" 
                        CornerRadius ="42" Pressed="OnButtonDown" Released="OnButtonUp"/>
                <Button Text="DOWN" WidthRequest="85" HeightRequest="85" Grid.Row="2" Grid.Column="1" 
                        CornerRadius ="42" Pressed="OnButtonDown" Released="OnButtonUp"/>
                <Button Text="RIGHT" WidthRequest="85" HeightRequest="85" Grid.Row="1" Grid.Column="2" 
                        CornerRadius ="42" Pressed="OnButtonDown" Released="OnButtonUp"/>
            </Grid>

            <!-- Action Buttons (Right Center) - Now more compact -->
            <!-- Action Buttons (Right Center) - Tightly Packed -->
            <Grid AbsoluteLayout.LayoutBounds="0.70,0.17,-1,-1"
              AbsoluteLayout.LayoutFlags="PositionProportional"
              ColumnSpacing="-15" RowSpacing="-15"
              RowDefinitions="Auto,Auto,Auto"
              ColumnDefinitions="Auto,Auto,Auto">

                <Button Text="Y" Grid.Row="0" Grid.Column="1"
                    WidthRequest="85" HeightRequest="85" CornerRadius="42"
                    Pressed="OnButtonDown" Released="OnButtonUp"/>

                <Button Text="X" Grid.Row="1" Grid.Column="0"
                    WidthRequest="85" HeightRequest="85" CornerRadius="42"
                    Pressed="OnButtonDown" Released="OnButtonUp"/>

                <Button Text="B" Grid.Row="1" Grid.Column="2"
                    WidthRequest="85" HeightRequest="85" CornerRadius="42"
                    Pressed="OnButtonDown" Released="OnButtonUp"/>

                <Button Text="A" Grid.Row="2" Grid.Column="1"
                    WidthRequest="85" HeightRequest="85" CornerRadius="42"
                    Pressed="OnButtonDown" Released="OnButtonUp"/>
            </Grid>



        </AbsoluteLayout>
    </Grid>

</ContentPage>
