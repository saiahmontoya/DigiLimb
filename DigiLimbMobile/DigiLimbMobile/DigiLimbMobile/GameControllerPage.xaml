<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigiLimbMobile.GameControllerPage"
             Title="Game Controller">

    <Grid Padding="20" RowDefinitions="*,*,*,*,*,*,*,*,*" ColumnDefinitions="*,*,*,*">

        <!-- Directional Pad -->
        <Button Text="⬅" Grid.Row="1" Grid.Column="1" Clicked="OnButtonPress" WidthRequest="70" HeightRequest="70"/>
        <Button Text="⬆" Grid.Row="0" Grid.Column="2" Clicked="OnButtonPress" WidthRequest="70" HeightRequest="70"/>
        <Button Text="⬇" Grid.Row="2" Grid.Column="2" Clicked="OnButtonPress" WidthRequest="70" HeightRequest="70"/>
        <Button Text="➡" Grid.Row="1" Grid.Column="3" Clicked="OnButtonPress" WidthRequest="70" HeightRequest="70"/>

        <!-- Action Buttons -->
        <Button Text="X" Grid.Row="6" Grid.Column="2" Clicked="OnButtonPress" WidthRequest="70" HeightRequest="70"/>
        <Button Text="A" Grid.Row="7" Grid.Column="1" Clicked="OnButtonPress" WidthRequest="70" HeightRequest="70"/>
        <Button Text="Y" Grid.Row="7" Grid.Column="3" Clicked="OnButtonPress" WidthRequest="70" HeightRequest="70"/>
        <Button Text="B" Grid.Row="8" Grid.Column="2" Clicked="OnButtonPress" WidthRequest="70" HeightRequest="70"/>

        <!-- Back Button -->
        <Button Text="Back" Grid.Row="9" Grid.ColumnSpan="4" Clicked="OnBackClicked" HorizontalOptions="Center"/>

    </Grid>

</ContentPage>
