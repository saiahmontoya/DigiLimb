<ContentPage 
    x:Class="DigiLimbMobile.ScreenViewerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Screen Viewer">

    <Grid>
        <ScrollView Orientation="Both" HorizontalScrollBarVisibility="Always" VerticalScrollBarVisibility="Always">
            <Image x:Name="imgScreen"
                   Aspect="AspectFit"
                   BackgroundColor="Black"
                   WidthRequest="{OnPlatform Android=1000, iOS=1000, Default=1000}" />
        </ScrollView>

        <Label x:Name="lblStatus"
               Text="Status"
               BackgroundColor="Black"
               TextColor="White"
               HorizontalOptions="Center"
               VerticalOptions="End"
               Padding="10"/>
    </Grid>
</ContentPage>
