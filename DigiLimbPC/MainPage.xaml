<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigiLimbDesktop.MainPage"
             Title="Main Menu"
             BackgroundColor="#EAEAEA">

    <!-- Wrap everything in a ScrollView to ensure full scrolling -->
    <ScrollView HorizontalScrollBarVisibility="Never">
        <VerticalStackLayout Padding="0,50" Spacing="25">

            <!-- 🔹 Title Box (Replaced Frame with Border) -->
            <Border Background="White"
                    Stroke="Gray"
                    StrokeShape="RoundRectangle 15"
                    Padding="0, 15"
                    Margin="30,50,30,20"
                    HorizontalOptions="CenterAndExpand"
                    WidthRequest="400">

                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.2" Offset="4,4"/>
                </Border.Shadow>

                <Label x:Name="lblDeviceName"
                       Text="DigiLimb Dashboard"
                       FontSize="30"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="#2D2D2D"
                       VerticalOptions="Center"/>
            </Border>

            <!-- 🔹 Connection Status Box (Replaced Frame with Border) -->
            <Border x:Name="connectionStatusBox"
                    IsVisible="False"
                    HorizontalOptions="Center"
                    Background="White"
                    Stroke="Gray"
                    StrokeShape="RoundRectangle 15"
                    Padding="0, 15"
                    Margin="0,15,0,10">

                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.2" Offset="4,4"/>
                </Border.Shadow>

                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="Auto, *">
                    <!-- Bluetooth/WiFi Icon -->
                    <Image x:Name="connectionIcon"
                           WidthRequest="30"
                           HeightRequest="30"
                           VerticalOptions="Center"
                           HorizontalOptions="Start"
                           Grid.Row="0"
                           Grid.Column="0"
                           Margin="5,0,10,0"/>

                    <!-- Device Name & Connection Type -->
                    <StackLayout Grid.Row="0" Grid.Column="1">
                        <Label Text="Paired Device:" 
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="Black"/>
                        <Label x:Name="lblPairedDevice"
                               FontSize="14"
                               TextColor="DarkGray"/>
                    </StackLayout>

                    <!-- View Dashboard Button -->
                    <Button Text="View Dashboard"
                            Clicked="OnViewConnectionDashboardClicked"
                            Style="{StaticResource HoverButtonStyle}"
                            FontSize="14"
                            Padding="10"
                            TextColor="White"
                            MaximumHeightRequest="30"
                            WidthRequest="100"
                            HorizontalOptions="End"
                            VerticalOptions="End"
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <!-- 🔹 Menu Container (Replaced Frame with Border) -->
            <Border Margin="30"
                    Padding="40,40,40,40"
                    Stroke="Gray"
                    StrokeShape="RoundRectangle 20"
                    Background="White"
                    MinimumWidthRequest="450"
                    HorizontalOptions="CenterAndExpand">

                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.2" Offset="4,4"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="25"  
                                     Padding="0,20"
                                     HorizontalOptions="CenterAndExpand"
                                     VerticalOptions="Center"
                                     MinimumWidthRequest="360">

                    <!-- Connections Button -->
                    <Button Text="Connections"
                            Clicked="OnConnectionsClicked"
                            Style="{StaticResource HoverButtonStyle}"
                            HorizontalOptions="CenterAndExpand"
                            />

                    <!-- Emulation Button -->
                    <Button Text="Emulation"
                            Clicked="OnEmulationClicked"
                            Style="{StaticResource HoverButtonStyle}"
                            HorizontalOptions="CenterAndExpand"
                            />

                    <!-- Settings Button -->
                    <Button Text="Settings"
                            Clicked="OnSettingsClicked"
                            Style="{StaticResource HoverButtonStyle}"
                            HorizontalOptions="CenterAndExpand"
                            />

                    <!-- Devices Button -->
                    <Button Text="Devices"
                            Clicked="OnDevicesClicked"
                            Style="{StaticResource HoverButtonStyle}"
                            HorizontalOptions="CenterAndExpand"
                            />

                    <!-- Support Button -->
                    <Button Text="Support"
                            Clicked="OnSupportClicked"
                            Style="{StaticResource HoverButtonStyle}"
                            HorizontalOptions="CenterAndExpand"
                            />
                </VerticalStackLayout>
            </Border>

            <!-- 🔹 Quit Button -->
            <Button Text="Quit"
                    Clicked="OnQuitClicked"
                    Style="{StaticResource QuitButtonStyle}"
                    HorizontalOptions="CenterAndExpand"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
