<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigiLimbDesktop.ConnectionsPage"
             Title="Connections"
             BackgroundColor="#EAEAEA">
    <!-- ✅ Updated Page Background -->

    <!-- Scrollable Layout -->
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25">

            <!-- 🔹 Bluetooth Connection Card -->
            <Border Background="LightBlue"
                    Stroke="Black"
                    StrokeShape="RoundRectangle 15"
                    Padding="20"
                    Margin="5"
                    HeightRequest="200">

                <!-- ✅ Corrected Shadow Implementation -->
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.2" Offset="8,8"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">

                    <!-- Row 1: Bluetooth Icon + Label -->
                    <HorizontalStackLayout>
                        <Image Source="bluetoothicon.png"
                               WidthRequest="30"
                               HeightRequest="30"
                               VerticalOptions="Center"
                               Margin="0,0,10,0"/>

                        <!-- Labels (Only One is Visible at a Time) -->
                        <Label x:Name="lblAwaitingConnection"
                               Text="No device paired."
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#333"
                               VerticalOptions="Center"
                               IsVisible="True"/>

                        <Label x:Name="lblConnectedDevice"
                               Text="Connected to: Device Name"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#333"
                               VerticalOptions="Center"
                               IsVisible="False"/>
                    </HorizontalStackLayout>

                    <!-- Row 2: Bluetooth Button -->
                    <Button x:Name="btnAllowIncomingConnection"
                            Text="Allow Incoming Bluetooth Connection"
                            Clicked="btnAllowIncomingConnection_Click"
                            Style="{StaticResource HoverButtonStyle}"
                            TextColor="White"
                            HeightRequest="50"
                            WidthRequest="350"
                            FontSize="16"
                            HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <!-- 🔹 WiFi Connection Card -->
            <Border Background="LightBlue"
                    Stroke="Black"
                    StrokeShape="RoundRectangle 15"
                    Padding="20"
                    Margin="5">

                <!-- ✅ Corrected Shadow Implementation -->
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.2" Offset="8,8"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="15">

                    <!-- Row 1: WiFi Icon + Label -->
                    <HorizontalStackLayout>
                        <Image Source="wifiicon.png"
                               WidthRequest="30"
                               HeightRequest="30"
                               VerticalOptions="Center"
                               Margin="0,0,10,0"/>

                        <Label x:Name="lblPairedDevice"
                               FontSize="18"
                               Text="No device paired"
                               TextColor="#333"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <!-- Row 2: WiFi Server Buttons -->
                    <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                        <Button x:Name="btnStartServer"
                                Text="Start WiFi Server"
                                Clicked="btnStartServer_Click"
                                Style="{StaticResource HoverButtonStyle}"
                                TextColor="White"
                                HeightRequest="50"/>
                        <Button x:Name="btnStopServer"
                                Text="Stop WiFi Server"
                                Clicked="btnStopServer_Click"
                                Style="{StaticResource QuitButtonStyle}"
                                TextColor="White"
                                IsEnabled="False"
                                HeightRequest="50"/>
                    </HorizontalStackLayout>

                    <!-- Row 3: Chat Section -->
                    <Label Text="Chat" FontSize="20" FontAttributes="Bold" Margin="0,15,0,5" TextColor="#333"/>
                    <Entry x:Name="entryChatMessage" Placeholder="Enter message to send" />
                    <Button x:Name="btnSendChat" Text="Send Chat" Clicked="OnSendChatClicked" Style="{StaticResource HoverButtonStyle}" TextColor="White"/>

                    <!-- Row 4: Log Area -->
                    <Label Text="Connection Logs" FontSize="18" FontAttributes="Bold" Margin="0,15,0,5" TextColor="#333"/>
                    <Editor x:Name="txtLogs"
                            HeightRequest="150"
                            IsReadOnly="True"
                            BackgroundColor="#ffffff"/>
                </VerticalStackLayout>
            </Border>

            <!-- Back Button -->
            <Button x:Name="btnBack"
                    Text="Back"
                    Clicked="btnBack_Click"
                    Style="{StaticResource QuitButtonStyle}"
                    TextColor="White"
                    HeightRequest="50"
                    FontSize="16"
                    HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
