<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="DigiLimbDesktop.ConnectionsPage"
            Title="Connections">

    <VerticalStackLayout Padding="30" Spacing="25">

        <!-- Awaiting Connection Message -->
        <Label x:Name="lblAwaitingConnection"
            Text="No device paired."
            IsVisible="True"
            FontSize="20"
            FontAttributes="Bold"
            TextColor="OrangeRed"
            HorizontalOptions="Center"
            Margin="0,10,0,10"/>

        <!-- Allow Incoming Connection Button -->
        <Button x:Name="btnAllowIncomingConnection"
            Text="Allow Incoming Bluetooth Connection"
            Clicked="btnAllowIncomingConnection_Click"
            IsVisible="True"
            BackgroundColor="Blue"
            TextColor="White"
            HeightRequest="50"
            FontSize="16"/>

        <!-- Connected Device Info -->
        <Label x:Name="lblConnectedDevice"
            Text="No device connected"
            TextColor="Red"
            FontSize="18"
            IsVisible="True"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            FontAttributes="Bold"/>

        <!-- Paired Device Info -->
        <Label x:Name="lblPairedDevice"
            FontSize="18"
            Text="No device paired"
            Margin="0,10,0,5"
            TextColor="Green"
            IsVisible="False"/>

        <!-- Server Control Buttons (WiFi) -->
        <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
            <Button x:Name="btnStartServer"
                Text="Start WiFi Server"
                Clicked="btnStartServer_Click"
                BackgroundColor="Green"
                TextColor="White"
                HeightRequest="50"/>
            <Button x:Name="btnStopServer"
                Text="Stop WiFi Server"
                Clicked="btnStopServer_Click"
                BackgroundColor="Red"
                TextColor="White"
                IsEnabled="False"
                HeightRequest="50"/>
        </HorizontalStackLayout>

        <!-- Chat Section -->
        <Label Text="Chat" FontSize="20" FontAttributes="Bold" Margin="0,15,0,5"/>
        <Entry x:Name="entryChatMessage" Placeholder="Enter message to send" />
        <Button x:Name="btnSendChat" Text="Send Chat" Clicked="OnSendChatClicked" BackgroundColor="Gray" TextColor="White"/>

        <!-- Log Area -->
        <Label Text="Connection Logs" FontSize="18" FontAttributes="Bold" Margin="0,15,0,5"/>
        <Editor x:Name="txtLogs"
            HeightRequest="150"
            IsReadOnly="True"
            BackgroundColor="LightGray"/>

        <!-- Back Button -->
        <Button x:Name="btnBack"
            Text="Back"
            Clicked="btnBack_Click"
            BackgroundColor="Gray"
            TextColor="White"
            HeightRequest="50"
            FontSize="16"
            HorizontalOptions="Center"/>
    </VerticalStackLayout>
</ContentPage>
