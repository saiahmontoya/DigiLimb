<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigiLimbDesktop.ConnectionDashboard"
             Title="Connection Dashboard">
    <StackLayout Padding="20">
        <Label Text="Connection Dashboard" FontSize="24" FontAttributes="Bold" />

        <Label x:Name="lblDeviceName" FontSize="18" />
        <Label x:Name="lblConnectionType" />
        <Label x:Name="lblConnectionStrength" />
        <Label x:Name="lblConnectionDuration" />
        <Label x:Name="lblCurrentEmulator" />

        <Button Text="End Connection" BackgroundColor="Red"
                TextColor="White" Clicked="OnEndConnectionClicked"/>
    </StackLayout>
</ContentPage>