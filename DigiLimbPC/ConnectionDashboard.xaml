<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigiLimbDesktop.ConnectionDashboard"
             Title="Connection Dashboard"
             BackgroundColor="#EAEAEA">

    <ScrollView>
        <Grid VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
        <VerticalStackLayout Padding="30" Spacing="35"
                             HorizontalOptions="FillAndExpand"
                             VerticalOptions="FillAndExpand"
                             WidthRequest="400">

            <!-- 🔹 Title -->
            <Label Text="🔗 Connection Dashboard"
                   FontSize="30"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="Black"
                   Margin="0,0,0,15"/>

            <!-- 🔹 Device Information Box (Expanded Size) -->
            <Frame BackgroundColor="White"
                   CornerRadius="15"
                   Padding="25"
                   HasShadow="True"
                   BorderColor="Gray"
                   WidthRequest="400"
                   HeightRequest="350"
                   HorizontalOptions="FillAndExpand">

                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnDefinitions="Auto, *, Auto">

                    <!-- 🔹 Bluetooth/WiFi Icon -->
                    <Image x:Name="connectionIcon"
                           MinimumWidthRequest="60"
                           MinimumHeightRequest="60"
                           MaximumWidthRequest ="100"
                           MaximumHeightRequest ="100"
                           VerticalOptions="CenterAndExpand"
                           HorizontalOptions="StartAndExpand"
                           Grid.Row="0"
                           Grid.Column="0"
                           Margin="0,0,0,0"/>

                    <!-- 🔹 Paired Device (Header) -->
                    <Label Text="Paired Device:"
                           FontSize="18"
                           TextColor="Black"
                           FontAttributes="Bold"
                           Grid.Row="0"
                           Grid.Column="1"
                           VerticalOptions="Center"/>

                    <Label x:Name="lblDeviceName"
                           FontSize="16"
                           TextColor="Black"
                           Grid.Row="1"
                           Grid.Column="1"
                           Margin="0,5,0,10"/>

                    <!-- 🔹 Connection Type -->
                    <Label Text="Connection Type:"
                           FontSize="16"
                           TextColor="Gray"
                           Grid.Row="2"
                           Grid.Column="0"
                           Margin="0,10,0,0"/>

                    <Label x:Name="lblConnectionType"
                           FontSize="16"
                           TextColor="Black"
                           Grid.Row="2"
                           Grid.Column="1"
                           Margin="0,10,0,0"/>

                    <!-- 🔹 Connection Strength with Image and Text Closer -->
                    <Label Text="Connection Strength:"
                           FontSize="16"
                           TextColor="Gray"
                           Grid.Row="3"
                           Grid.Column="0"
                           Margin="0,10,0,0"/>

                    <StackLayout Orientation="Horizontal"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Start"
                                 Spacing="5"
                                 Grid.Row="3"
                                 Grid.Column="1">

                        <Image x:Name="connectionStrengthIcon"
                               WidthRequest="25"
                               HeightRequest="25"
                               VerticalOptions="Center"/>

                        <Label x:Name="lblConnectionStrength"
                               FontSize="16"
                               TextColor="Black"
                               VerticalOptions="Center"/>
                    </StackLayout>
                    

                    <!-- 🔹 Connection Duration -->
                    <Label Text="Connection Duration:"
                           FontSize="16"
                           TextColor="Gray"
                           Grid.Row="4"
                           Grid.Column="0"
                           Margin="0,10,0,0"/>

                    <Label x:Name="lblConnectionDuration"
                           FontSize="16"
                           TextColor="Black"
                           Grid.Row="4"
                           Grid.Column="1"
                           Margin="0,10,0,0"/>

                    <!-- 🔹 Current Emulator -->
                    <Label Text="Current Emulator:"
                           FontSize="16"
                           TextColor="Gray"
                           Grid.Row="5"
                           Grid.Column="0"
                           Margin="0,10,0,0"/>

                    <Label x:Name="lblCurrentEmulator"
                           FontSize="16"
                           TextColor="Black"
                           Grid.Row="5"
                           Grid.Column="1"
                           Margin="0,10,0,0"/>
                </Grid>
            </Frame>

            <!-- 🔹 End Connection Button -->
            <Button Text="End Connection"
                    Style="{StaticResource QuitButtonStyle}"
                    TextColor="White"
                    FontSize="18"
                    HeightRequest="55"
                    CornerRadius="12"
                    WidthRequest="280"
                    HorizontalOptions="Center"
                    Clicked="OnEndConnectionClicked"/>

        </VerticalStackLayout>
    </Grid>
    </ScrollView>

</ContentPage>
