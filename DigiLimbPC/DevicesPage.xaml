<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DigiLimbDesktop.DevicesPage"
    Title="My Devices"
    BackgroundColor="Black">

    <VerticalStackLayout Padding="20">

        <Label Text="Registered Devices"
               FontSize="24"
               TextColor="Cyan"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               Margin="0,0,0,10"/>

        <!-- Device List -->
        <ListView x:Name="devicesListView"
                  BackgroundColor="Black"
                  HasUnevenRows="True">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Frame Padding="15"
                               BackgroundColor="Gray"
                               CornerRadius="10"
                               BorderColor="Lime"
                               HasShadow="True"
                               Margin="0,10,0,10">

                            <VerticalStackLayout Spacing="5">

                                <!-- Model -->
                                <Label Text="{Binding DeviceModel, StringFormat='Model: {0}'}"
                                       FontSize="18"
                                       TextColor="White"
                                       FontAttributes="Bold"/>

                                <!-- Manufacturer -->
                                <Label Text="{Binding Manufacturer, StringFormat='Manufacturer: {0}'}"
                                       FontSize="14"
                                       TextColor="LightGray"/>

                                <!-- Platform -->
                                <Label Text="{Binding Platform, StringFormat='Platform: {0}'}"
                                       FontSize="14"
                                       TextColor="LightGray"/>

                                <!-- OS Version -->
                                <Label Text="{Binding OsVersion, StringFormat='OS Version: {0}'}"
                                       FontSize="14"
                                       TextColor="LightGray"/>

                                <!-- Device Type -->
                                <Label Text="{Binding DeviceType, StringFormat='Device Type: {0}'}"
                                       FontSize="14"
                                       TextColor="LightGray"/>

                                <!-- CreatedAt (DateTime) -->
                                <Label Text="{Binding CreatedAt, StringFormat='Created At: {0:yyyy-MM-dd HH:mm:ss}'}"
                                       FontSize="14"
                                       TextColor="Cyan"
                                       FontAttributes="Italic"/>

                                <!-- MAC Address -->
                                <Label Text="{Binding MacAddress, StringFormat='MAC Address: {0}'}"
                                       FontSize="14"
                                       TextColor="Cyan"
                                       FontAttributes="Italic"/>

                            </VerticalStackLayout>

                        </Frame>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Back Button -->
        <Button Text="Back"
                Clicked="OnBackClicked"
                BackgroundColor="Black"
                TextColor="White"
                BorderColor="Red"
                BorderWidth="2"
                HorizontalOptions="Center"
                Margin="0,20,0,0"/>
    </VerticalStackLayout>

</ContentPage>
