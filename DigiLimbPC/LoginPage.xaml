<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigiLimbDesktop.LoginPage"
             BackgroundColor="{DynamicResource PageBackgroundColor}">
    <ScrollView >
        <VerticalStackLayout Padding="30, 30, 30, 0" Spacing="20">

            <!-- Background Image (Optional) -->
        <!-- Image Aspect="AspectFill" Source="digilogin.webp"/ -->

        <!-- Transparent Overlay -->
            

            <!-- App Logo -->
        <!-- Grid Grid.Row="0">
            <Image Aspect="AspectFit"
                   HeightRequest="100"
                   Source="applogo.jpg!sw800" 
                   HorizontalOptions="Center"/>
        </Grid -->

        <!-- Login Container -->
            <Frame Margin="0, 10, 0, 0"  
                Padding="0, 30, 0, 10"
                    HorizontalOptions="FillAndExpand"
                CornerRadius="20"
                   BackgroundColor="{DynamicResource CardBackgroundColor}"
                   HasShadow="True">

                <VerticalStackLayout Spacing="25" Padding="5" >

                    <Label FontAttributes="Bold"
                           FontSize="40"
                           Text="DigiLimb"
                           TextColor="{DynamicResource PrimaryTextColor}"
                           HorizontalOptions="Center"/>

                    <Label Text="Log in to continue"
                           FontSize="14"
                           TextColor="{DynamicResource PrimaryTextColor}"
                           HorizontalOptions="Center"/>

                    <!-- Email Entry -->
                    <Grid ColumnDefinitions="0, *" Margin="20,10,20,0">
                        <Image Source="accountimage.png"
                               HeightRequest="30"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>
                        <Entry x:Name="txtEmail"
                               Grid.Column="1"
                               Placeholder="Email"
                               Keyboard="Email"
                               BackgroundColor="{DynamicResource EntryBackgroundColor}"
                               TextColor="{DynamicResource PrimaryTextColor}"
                               VerticalOptions="Center"/>
                    </Grid>

                    <!-- Password Entry -->
                    <Grid ColumnDefinitions="0, *" Margin="20,10,20,0">
                        <Image Source="keyimage.png"
                               HeightRequest="30"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"/>
                        <Entry x:Name="txtPassword"
                               Grid.Column="1"
                               Placeholder="Password"
                               IsPassword="True"
                               BackgroundColor="{DynamicResource EntryBackgroundColor}"
                               TextColor="{DynamicResource PrimaryTextColor}"
                               VerticalOptions="Center"/>
                    </Grid>

                    <!-- Buttons -->
                    <Button Text="Login"
                            Clicked="OnLoginClicked"
                            Style="{StaticResource HoverButtonStyle}"
                            TextColor="White"
                            HorizontalOptions="FillAndExpand"
                            HeightRequest="55"
                            FontSize="18"
                            CornerRadius="10"
                            Margin="15,15,15,0"/>

                    <Button Text="Register"
                            Clicked="OnRegisterClicked"
                             Style="{StaticResource QuitButtonStyle}"
                            TextColor="White"
                            HeightRequest="55"
                            FontSize="18"
                            CornerRadius="10"
                            Margin="15,15,15,15"/>

                </VerticalStackLayout>
            </Frame>
       

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
