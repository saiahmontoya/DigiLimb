<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DigiLimbDesktop.ScreenViewer"
             Title="Screen Viewer">

    <Grid Padding="20" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title -->
        <Label Grid.Row="0"
               Text="Screen Viewer"
               FontSize="22"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <!-- Screen Image Display -->
        <Frame Grid.Row="1"
               HasShadow="True"
               BorderColor="Gray"
               Padding="3"
               BackgroundColor="Black">
            <Image x:Name="ScreenImage"
                   Aspect="AspectFill"
                   BackgroundColor="Black" />
        </Frame>

        <!-- Start Screen Sharing Button -->
        <Button Grid.Row="2"
                x:Name="StartScreenViewerButton"
                Text="Start Screen Viewer"
                BackgroundColor="Green"
                TextColor="White"
                Clicked="OnStartScreenViewerClicked"
                HeightRequest="50"/>

        <!-- Stop Screen Sharing Button -->
        <Button Grid.Row="3"
                x:Name="StopScreenViewerButton"
                Text="Stop Screen Viewer"
                BackgroundColor="Red"
                TextColor="White"
                Clicked="OnStopScreenViewerClicked"
                HeightRequest="50"
                IsVisible="False"/>

        <!-- Status Message -->
        <Label Grid.Row="4"
               x:Name="StatusLabel"
               Text="Waiting for connection..."
               FontSize="16"
               HorizontalOptions="Center"
               TextColor="Gray"/>
    </Grid>
</ContentPage>
