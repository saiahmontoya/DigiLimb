<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DigiLimbDesktop"
             x:Class="DigiLimbDesktop.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 🔹 Global Button Style with Hover Effect & Rounded Shadow -->
            <Style x:Key="HoverButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="#037ffc"/>
                <!-- Default color -->
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="MinimumHeightRequest" Value="55"/>
                <Setter Property="MinimumWidthRequest" Value="250"/>

                <!-- ✅ Define Default Rounded Shadow -->
                <Setter Property="Shadow">
                    <Shadow Brush="Black" Opacity="0.2" Offset="3,3" Radius="10"/>
                </Setter>

                <!-- ✅ Define Hover Effect & Stronger Rounded Shadow on Hover -->
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#037ffc"/>
                                    <!-- Ensures default color -->
                                    <Setter Property="Shadow">
                                        <Shadow Brush="Black" Opacity="0.2" Offset="3,3" Radius="10"/>
                                    </Setter>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#026DD9"/>
                                    <!-- Darker blue on hover -->
                                    <Setter Property="Shadow">
                                        <Shadow Brush="Black" Opacity="0.4" Offset="5,5" Radius="12"/>
                                        <!-- Softer, rounder shadow -->
                                    </Setter>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <!-- 🔹 Quit Button Style (With Hover Effect & Rounded Shadow) -->
            <Style x:Key="QuitButtonStyle" TargetType="Button" BasedOn="{StaticResource HoverButtonStyle}">
                <Setter Property="BackgroundColor" Value="#4e92bf"/>
                <!-- Default red -->
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#4e92bf"/>
                                    <!-- Ensures it returns to red -->
                                    <Setter Property="Shadow">
                                        <Shadow Brush="Black" Opacity="0.2" Offset="3,3" Radius="10"/>
                                    </Setter>
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#3B779F"/>
                                    <!-- Darker red on hover -->
                                    <Setter Property="Shadow">
                                        <Shadow Brush="Black" Opacity="0.4" Offset="5,5" Radius="12"/>
                                        <!-- Softer, rounder shadow -->
                                    </Setter>
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
